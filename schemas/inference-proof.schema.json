{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inference-proof.schema.json",
  "title": "推理凭证",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "deployment_id", "plan_sha256", "endpoint", "request", "job", "output_binding", "output"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "producer": {"const": "HARNESS_HTTP_RUNNER"},
    "deployment_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "endpoint": {"type": "string", "format": "uri"},
    "request": {"type": "object", "additionalProperties": false, "required": ["method", "path", "payload", "submitted_at"], "properties": {"method": {"const": "POST"}, "path": {"type": "string", "pattern": "^/"}, "payload": {"$ref": "common.schema.json#/$defs/artifactReference"}, "submitted_at": {"$ref": "common.schema.json#/$defs/timestamp"}}},
    "job": {"type": "object", "additionalProperties": false, "required": ["job_id", "status", "completed_at", "response", "runtime_error"], "properties": {"job_id": {"type": "string", "minLength": 1}, "status": {"const": "COMPLETED"}, "completed_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "response": {"$ref": "common.schema.json#/$defs/artifactReference"}, "runtime_error": {"type": "null"}}},
    "output_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolver", "job_id", "response_artifact_pointer", "artifact_id", "content_url", "downloaded_at", "download_sha256", "download_content_length", "response_headers"],
      "allOf": [
        {
          "if": {"properties": {"resolver": {"const": "RECIPE_JSON_POINTER_FIELDS"}}},
          "then": {"required": ["response_url_pointer", "response_sha256_pointer", "response_content_sha256"]}
        },
        {
          "if": {"properties": {"resolver": {"const": "RECIPE_OUTPUT_ITEM"}}},
          "then": {"required": ["request_token_pointer", "job_token", "filename", "subfolder", "output_type", "output_node_id", "output_collection", "output_index"]}
        }
      ],
      "properties": {
        "resolver": {"enum": ["RECIPE_JSON_POINTER_FIELDS", "RECIPE_OUTPUT_ITEM"]},
        "job_id": {"type": "string", "minLength": 1},
        "response_artifact_pointer": {"type": "string", "pattern": "^/"},
        "response_url_pointer": {"type": "string", "pattern": "^/"},
        "response_sha256_pointer": {"type": "string", "pattern": "^/"},
        "artifact_id": {"type": "string", "minLength": 1},
        "content_url": {"type": "string", "format": "uri"},
        "response_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_token_pointer": {"type": "string", "pattern": "^/"},
        "job_token": {"type": "string", "minLength": 32},
        "filename": {"type": "string", "minLength": 1},
        "subfolder": {"type": "string"},
        "output_type": {"type": "string", "minLength": 1},
        "output_node_id": {"type": "string", "minLength": 1},
        "output_collection": {"type": "string", "minLength": 1},
        "output_index": {"type": "integer", "minimum": 0},
        "downloaded_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "download_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "download_content_length": {"type": "string", "pattern": "^[0-9]+$"},
        "response_headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "etag": {"type": "string", "minLength": 1},
            "last_modified": {"type": "string", "minLength": 1},
            "content_length": {"type": "string", "pattern": "^[0-9]+$"}
          }
        }
      },
      "dependentRequired": {
        "response_sha256_pointer": ["response_content_sha256"],
        "response_content_sha256": ["response_sha256_pointer"]
      }
    },
    "output": {"$ref": "common.schema.json#/$defs/artifactReference"}
  }
}
