{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-plan.schema.json",
  "title": "部署计划",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment_id", "request_id", "created_at", "host_profile_observed_at", "target", "model", "framework", "compatibility", "environment", "service", "lifecycle", "executor_controls", "steps", "risks", "required_changes", "evidence", "verification", "rollback", "license_gate", "review", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "deployment_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "host_profile_observed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "target": {
      "type": "object", "additionalProperties": false, "required": ["host_id", "gpu_ids", "install_root", "model_root"],
      "properties": {"host_id": {"type": "string", "minLength": 1}, "gpu_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/gpuId"}}, "install_root": {"$ref": "common.schema.json#/$defs/absolutePath"}, "model_root": {"$ref": "common.schema.json#/$defs/absolutePath"}}
    },
    "model": {"type": "object", "additionalProperties": false, "required": ["id", "variant", "recipe_ref"], "properties": {"id": {"type": "string", "minLength": 1}, "variant": {"type": "string", "minLength": 1}, "recipe_ref": {"type": "string", "minLength": 1}}},
    "framework": {"type": "object", "additionalProperties": false, "required": ["name", "version", "recipe_ref", "runtime_artifact", "rationale", "evidence_ids"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "recipe_ref": {"type": "string", "minLength": 1}, "runtime_artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "location", "revision", "probe_command", "executable"], "properties": {"kind": {"const": "source_checkout"}, "location": {"$ref": "common.schema.json#/$defs/absolutePath"}, "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"}, "probe_command": {"type": "array", "minItems": 5, "items": {"type": "string"}}, "executable": {"$ref": "common.schema.json#/$defs/absolutePath"}}}, "rationale": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "compatibility": {"type": "object", "additionalProperties": false, "required": ["profile_id", "required_cuda"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "required_cuda": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["strategy", "isolated", "rationale"], "properties": {"strategy": {"type": "string", "enum": ["container", "venv"]}, "isolated": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["mode", "bind_host", "port"], "properties": {"mode": {"type": "string", "enum": ["foreground", "managed_service", "container"]}, "bind_host": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["transitions"], "properties": {"transitions": {"type": "array", "minItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["stage", "completed_at", "artifact"], "properties": {"stage": {"type": "string", "enum": ["INTAKE", "REQUIREMENT_GATE", "HOST_DISCOVERY", "RESEARCH", "PLAN", "PLAN_REVIEW", "EXECUTE", "VERIFY", "RECORD"]}, "completed_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "artifact": {"$ref": "common.schema.json#/$defs/artifactReference"}}}}}},
    "executor_controls": {"type": "object", "additionalProperties": false, "required": ["remote_writer_lock"], "properties": {"remote_writer_lock": {"type": "object", "additionalProperties": false, "required": ["path", "acquire_command", "release_command"], "properties": {"path": {"const": "/tmp/model-deployment-harness-writer-lock"}, "acquire_command": {"type": "array", "prefixItems": [{"const": "mkdir"}, {"const": "/tmp/model-deployment-harness-writer-lock"}], "items": false, "minItems": 2, "maxItems": 2}, "release_command": {"type": "array", "prefixItems": [{"const": "rmdir"}, {"const": "/tmp/model-deployment-harness-writer-lock"}], "items": false, "minItems": 2, "maxItems": 2}}}}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "execution-step.schema.json"}},
    "risks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["risk_id", "description", "severity", "mitigation"], "properties": {"risk_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "severity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "mitigation": {"type": "string", "minLength": 1}}}},
    "required_changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["description", "action_class", "step_ids"], "properties": {"description": {"type": "string", "minLength": 1}, "action_class": {"type": "string", "enum": ["PLAN_ALLOWED_WRITE", "PROTECTED"]}, "step_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "research-evidence.schema.json"}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["recipe_ref", "required_levels", "success_condition"], "properties": {"recipe_ref": {"type": "string", "minLength": 1}, "required_levels": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "enum": ["L1_environment", "L2_process", "L3_port", "L4_api", "L5_real_inference", "L6_output_validation"]}, "allOf": [{"contains": {"const": "L5_real_inference"}}, {"contains": {"const": "L6_output_validation"}}]}, "success_condition": {"const": "L5_AND_L6_PASS"}}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["trigger_conditions", "steps", "preserve_evidence"], "properties": {"trigger_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "execution-step.schema.json"}}, "preserve_evidence": {"type": "boolean"}}},
    "license_gate": {"type": "object", "additionalProperties": false, "required": ["status", "license_type", "source_url", "checked_at", "deployment_region", "intended_use", "findings"], "properties": {"status": {"type": "string", "enum": ["PASS", "BLOCKED", "NEEDS_REVIEW"]}, "license_type": {"type": "string", "minLength": 1}, "source_url": {"type": "string", "format": "uri"}, "checked_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "deployment_region": {"type": "string", "minLength": 1}, "intended_use": {"type": "string", "minLength": 1}, "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "reviewed_by": {"type": "string", "minLength": 1}, "accepted_by": {"type": "string", "minLength": 1}, "accepted_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "authorization_reference": {"type": "string", "minLength": 1}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"]}, "reviewed_by": {"type": "string", "minLength": 1}, "reviewed_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "plan_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "notes": {"type": "string"}}},
    "status": {"type": "string", "enum": ["DRAFT", "NEEDS_USER_INPUT", "BLOCKED", "READY", "EXECUTING", "EXECUTED", "VERIFICATION_FAILED", "VERIFIED", "ROLLED_BACK"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "READY"}}, "required": ["status"]}, "then": {"properties": {"review": {"required": ["status", "reviewed_by", "reviewed_at", "plan_sha256"], "properties": {"status": {"const": "APPROVED"}}}, "license_gate": {"required": ["reviewed_by", "accepted_by", "accepted_at"], "properties": {"status": {"const": "PASS"}}}}}},
    {"if": {"properties": {"status": {"const": "VERIFIED"}}, "required": ["status"]}, "then": {"description": "计划状态仅是生命周期元数据；必须另有状态为 VERIFIED 的独立验证结果。"}}
  ]
}
