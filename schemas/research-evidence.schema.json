{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-evidence.schema.json",
  "title": "研究证据",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "source", "retrieved_at", "claim", "applies_to", "confidence", "officially_verified", "inference"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "authority_tier", "publisher"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "authority_tier": {"type": "string", "enum": ["S", "A", "B", "C", "D"]},
        "publisher": {"type": "string", "minLength": 1},
        "source_family": {"type": "string", "enum": ["comfyui_official", "github_issue_pr", "pypi_official_package", "csdn_technical_validation", "model_vendor_official", "framework_vendor_official", "other"]},
        "version": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"}
      }
    },
    "retrieved_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "claim": {"type": "string", "minLength": 1},
    "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
    "officially_verified": {"type": "boolean"},
    "inference": {"type": "boolean"},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
