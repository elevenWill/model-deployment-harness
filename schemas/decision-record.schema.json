{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-record.schema.json",
  "title": "决策记录",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "recorded_at", "status", "context", "decision", "rationale", "alternatives", "evidence_refs", "consequences"],
  "properties": {
    "schema_version": {"const": "1.0"}, "decision_id": {"type": "string", "minLength": 1}, "deployment_id": {"type": "string", "minLength": 1}, "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {"type": "string", "enum": ["PROPOSED", "ACCEPTED", "SUPERSEDED", "REJECTED"]}, "context": {"type": "string", "minLength": 1}, "decision": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1},
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["option", "reason_not_selected"], "properties": {"option": {"type": "string", "minLength": 1}, "reason_not_selected": {"type": "string", "minLength": 1}}}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "consequences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "superseded_by": {"type": "string", "minLength": 1}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "SUPERSEDED"}}, "required": ["status"]}, "then": {"required": ["superseded_by"]}}]
}
