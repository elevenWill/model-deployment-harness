{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incident.schema.json",
  "title": "事件",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "incident_id", "deployment_id", "host_id", "opened_at", "severity", "symptom", "environment", "status", "timeline"],
  "properties": {
    "schema_version": {"const": "1.0"}, "incident_id": {"type": "string", "minLength": 1}, "deployment_id": {"type": "string", "minLength": 1}, "host_id": {"type": "string", "minLength": 1},
    "opened_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "closed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "severity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "symptom": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["OPEN", "MITIGATED", "RESOLVED", "UNRESOLVED"]},
    "cause": {"type": "object", "additionalProperties": false, "required": ["status", "description"], "properties": {"status": {"type": "string", "enum": ["HYPOTHESIS", "CONFIRMED", "UNKNOWN"]}, "description": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "fix": {"type": "object", "additionalProperties": false, "required": ["description", "verified"], "properties": {"description": {"type": "string", "minLength": 1}, "verified": {"type": "boolean"}, "verification_ref": {"type": "string", "minLength": 1}}},
    "timeline": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["at", "event"], "properties": {"at": {"$ref": "common.schema.json#/$defs/timestamp"}, "event": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}}}},
    "artifacts": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactReference"}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "RESOLVED"}}, "required": ["status"]}, "then": {"required": ["closed_at", "cause", "fix"], "properties": {"cause": {"properties": {"status": {"const": "CONFIRMED"}}}, "fix": {"required": ["description", "verified", "verification_ref"], "properties": {"verified": {"const": true}}}}}}]
}
