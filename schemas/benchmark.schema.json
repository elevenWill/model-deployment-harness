{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark.schema.json",
  "title": "基准测试",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "deployment_id", "host_id", "recorded_at", "workload", "environment", "metrics", "verification_ref"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "workload": {"type": "object", "minProperties": 1},
    "environment": {"type": "object", "minProperties": 1},
    "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["number", "integer", "string"]}},
    "verification_ref": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
