{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake-draft.schema.json",
  "title": "部署需求草稿",
  "description": "可跨多轮对话递归合并的部分用户意图。草稿不能授权远程写入，也不得包含密码或 token。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "updated_at", "intent"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "draft_id": {"type": "string", "minLength": 1},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "requested_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "requested_by": {"type": "string", "minLength": 1},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "host_id": {"type": "string", "minLength": 1},
                "hostname": {"type": "string", "minLength": 1},
                "address": {"type": "string", "minLength": 1},
                "alias": {"type": "string", "minLength": 1},
                "ssh_username": {"type": "string", "minLength": 1},
                "ssh_port": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            },
            "gpu_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "common.schema.json#/$defs/gpuId"}
            },
            "install_root": {"$ref": "common.schema.json#/$defs/absolutePath"},
            "model_root": {"$ref": "common.schema.json#/$defs/absolutePath"}
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "variant": {"type": "string", "minLength": 1}
          }
        },
        "framework_preference": {
          "type": "string",
          "enum": ["sglang", "vllm-omni", "comfyui"]
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"type": "string", "enum": ["foreground", "managed_service", "container"]},
            "bind_host": {"type": "string", "minLength": 1},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "existing_environment_policy": {
          "type": "string",
          "enum": ["PRESERVE_AND_ISOLATE", "ALLOW_PLANNED_CHANGES"]
        },
        "intended_use": {"type": "string", "minLength": 1},
        "deployment_region": {"type": "string", "minLength": 1},
        "preferences": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "download_source": {"type": "string", "enum": ["huggingface", "modelscope"]},
            "environment_isolation": {
              "type": "string",
              "enum": ["isolated_uv", "isolated_venv", "container"]
            },
            "framework_selection": {
              "type": "string",
              "enum": ["user_selected", "delegate_to_supported_recipe"]
            },
            "port_policy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["strategy"],
              "properties": {
                "strategy": {"type": "string", "enum": ["exact", "prefer_default_then_available"]},
                "preferred_port": {"type": "integer", "minimum": 1, "maximum": 65535}
              },
              "allOf": [
                {
                  "if": {"properties": {"strategy": {"const": "exact"}}},
                  "then": {"required": ["preferred_port"]}
                }
              ]
            }
          }
        },
        "license_acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"type": "string", "enum": ["ACCEPTED", "DECLINED", "NEEDS_REVIEW"]},
            "accepted_by": {"type": "string", "minLength": 1},
            "accepted_at": {"$ref": "common.schema.json#/$defs/timestamp"},
            "authorization_reference": {"type": "string", "minLength": 1}
          }
        },
        "notes": {"type": "string"}
      }
    }
  }
}
