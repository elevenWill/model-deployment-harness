{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-record.schema.json",
  "title": "部署记录",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment_id", "host_id", "request_ref", "plan_ref", "model", "framework", "target", "deployment_status", "created_at", "updated_at", "known_state"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "deployment_id": {"type": "string", "minLength": 1}, "host_id": {"type": "string", "minLength": 1},
    "request_ref": {"type": "string", "minLength": 1}, "plan_ref": {"type": "string", "minLength": 1},
    "model": {"type": "object", "additionalProperties": false, "required": ["id", "variant", "path"], "properties": {"id": {"type": "string", "minLength": 1}, "variant": {"type": "string", "minLength": 1}, "path": {"$ref": "common.schema.json#/$defs/absolutePath"}}},
    "framework": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["gpu_ids", "install_root", "bind_host", "port"], "properties": {"gpu_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/gpuId"}}, "install_root": {"$ref": "common.schema.json#/$defs/absolutePath"}, "bind_host": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "deployment_status": {"type": "string", "enum": ["PLANNED", "EXECUTING", "STARTED", "VERIFICATION_FAILED", "VERIFIED", "STOPPED", "ROLLED_BACK", "FAILED", "UNKNOWN"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "known_state": {"type": "object", "additionalProperties": false, "required": ["recorded_at", "expected_service_state", "expected_port"], "properties": {"recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "expected_service_state": {"type": "string", "enum": ["RUNNING", "STOPPED", "UNKNOWN"]}, "expected_port": {"type": "integer", "minimum": 1, "maximum": 65535}, "verification_ref": {"type": "string", "minLength": 1}, "last_full_verification_at": {"$ref": "common.schema.json#/$defs/timestamp"}}},
    "observed_state": {"$ref": "#/$defs/observedState"},
    "decision_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "incident_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lesson_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "benchmark_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"observedState": {"type": "object", "additionalProperties": false, "required": ["checked_at", "ssh", "process", "port", "api", "inference"], "properties": {"checked_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "ssh": {"$ref": "common.schema.json#/$defs/outcome"}, "process": {"$ref": "common.schema.json#/$defs/outcome"}, "port": {"$ref": "common.schema.json#/$defs/outcome"}, "api": {"$ref": "common.schema.json#/$defs/outcome"}, "inference": {"$ref": "common.schema.json#/$defs/outcome"}, "host_profile_ref": {"type": "string", "minLength": 1}, "verification_ref": {"type": "string", "minLength": 1}}}},
  "allOf": [{"if": {"properties": {"deployment_status": {"const": "VERIFIED"}}, "required": ["deployment_status"]}, "then": {"properties": {"known_state": {"required": ["verification_ref", "last_full_verification_at"]}}}}]
}
