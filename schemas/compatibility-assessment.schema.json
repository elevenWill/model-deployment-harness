{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compatibility-assessment.schema.json",
  "title": "兼容性适配评估",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "request_id", "request_artifact", "host_id", "host_profile_observed_at", "host_profile_artifact", "adaptation_status", "next_stage", "gaps", "research", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assessment_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "request_artifact": {"$ref": "common.schema.json#/$defs/artifactReference"},
    "host_id": {"type": "string", "minLength": 1},
    "host_profile_observed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "host_profile_artifact": {"$ref": "common.schema.json#/$defs/artifactReference"},
    "adaptation_status": {"enum": ["RESEARCH_NEEDED", "READY_FOR_TRIAL", "VALIDATED", "BLOCKED"]},
    "next_stage": {"type": ["string", "null"], "enum": ["RESEARCH", "PLAN", null]},
    "gaps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["gap_id", "category", "description"], "properties": {"gap_id": {"type": "string", "minLength": 1}, "category": {"$ref": "#/$defs/gapCategory"}, "description": {"type": "string", "minLength": 1}}}},
    "research": {"type": "object", "additionalProperties": false, "required": ["status", "candidates"], "properties": {"status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED"]}, "selected_candidate_id": {"type": "string", "minLength": 1}, "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}}},
    "evidence": {"type": "array", "items": {"$ref": "research-evidence.schema.json"}}
  },
  "$defs": {
    "gapCategory": {"enum": ["recommended_profile_mismatch", "gpu_model_or_topology_difference", "memory_pressure", "runtime_version_mismatch", "framework_gap", "license", "safety", "physical_capacity", "unavailable_target", "protected_change_required", "unverifiable"]},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "description", "applies_to_gap_ids", "evidence_ids", "mitigation_mechanisms", "applicability_checks", "local_reproduction", "plan_conditions"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "applies_to_gap_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mitigation_mechanisms": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["mechanism_id", "description", "addresses_gap_ids", "evidence_ids"], "properties": {"mechanism_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "addresses_gap_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
        "applicability_checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "FAIL", "NOT_CHECKED"]}}}},
        "local_reproduction": {"$ref": "#/$defs/reproduction"},
        "plan_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "reproduction": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {"status": {"enum": ["NOT_RUN", "PASS", "FAIL"]}, "trial_evidence": {"type": "object", "additionalProperties": false, "required": ["checked_at", "trial_deployment_id", "trial_plan", "execution_record", "inference_proof", "semantic_review", "verification_result"], "properties": {"checked_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "trial_deployment_id": {"type": "string", "minLength": 1}, "trial_plan": {"$ref": "common.schema.json#/$defs/artifactReference"}, "execution_record": {"$ref": "common.schema.json#/$defs/artifactReference"}, "inference_proof": {"$ref": "common.schema.json#/$defs/artifactReference"}, "semantic_review": {"$ref": "common.schema.json#/$defs/artifactReference"}, "verification_result": {"$ref": "common.schema.json#/$defs/artifactReference"}}}},
      "allOf": [{"if": {"properties": {"status": {"enum": ["PASS", "FAIL"]}}, "required": ["status"]}, "then": {"required": ["trial_evidence"]}}, {"if": {"properties": {"status": {"const": "NOT_RUN"}}, "required": ["status"]}, "then": {"not": {"required": ["trial_evidence"]}}}]
    }
  }
}
