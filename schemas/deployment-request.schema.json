{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-request.schema.json",
  "title": "部署请求",
  "description": "必填用户意图。任何必填意图字段均无默认值；缺失时必须在侦察或执行前返回 NEEDS_USER_INPUT。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "requested_at", "requested_by", "target", "model", "framework_preference", "service", "existing_environment_policy", "intended_use", "deployment_region"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "requested_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "requested_by": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "gpu_ids", "install_root", "model_root"],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ssh_username", "ssh_port"],
          "anyOf": [
            {"required": ["host_id"]},
            {"required": ["hostname"]},
            {"required": ["address"]},
            {"required": ["alias"]}
          ],
          "properties": {
            "host_id": {"type": "string", "minLength": 1},
            "hostname": {"type": "string", "minLength": 1},
            "address": {"type": "string", "minLength": 1},
            "alias": {"type": "string", "minLength": 1},
            "ssh_username": {"type": "string", "minLength": 1},
            "ssh_port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "gpu_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/gpuId"}},
        "install_root": {"$ref": "common.schema.json#/$defs/absolutePath"},
        "model_root": {"$ref": "common.schema.json#/$defs/absolutePath"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variant"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1}
      }
    },
    "framework_preference": {"type": "string", "enum": ["sglang", "vllm-omni", "ALLOW_RECIPE_SELECTION"]},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "bind_host", "port"],
      "properties": {
        "mode": {"type": "string", "enum": ["foreground", "managed_service", "container"]},
        "bind_host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "existing_environment_policy": {"type": "string", "enum": ["PRESERVE_AND_ISOLATE", "ALLOW_PLANNED_CHANGES"]},
    "intended_use": {"type": "string", "minLength": 1},
    "deployment_region": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
