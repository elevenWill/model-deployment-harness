{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lifecycle-stage-source.schema.json",
  "title": "生命周期阶段来源",
  "type": "object",
  "required": ["schema_version", "stage", "request_id", "deployment_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"enum": ["INTAKE", "REQUIREMENT_GATE", "HOST_DISCOVERY", "RESEARCH", "PLAN", "PLAN_REVIEW"]},
    "request_id": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "request_complete": {"const": true},
    "gate_status": {"const": "PASS"},
    "missing_fields": {"type": "array", "maxItems": 0},
    "host_id": {"type": "string", "minLength": 1},
    "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "probe_status": {"const": "COMPLETE"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "plan_status": {"const": "DRAFT"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "review_status": {"const": "APPROVED"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "reviewed_plan_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "INTAKE"}}}, "then": {"required": ["request_complete"]}},
    {"if": {"properties": {"stage": {"const": "REQUIREMENT_GATE"}}}, "then": {"required": ["gate_status", "missing_fields"]}},
    {"if": {"properties": {"stage": {"const": "HOST_DISCOVERY"}}}, "then": {"required": ["host_id", "observed_at", "probe_status"]}},
    {"if": {"properties": {"stage": {"const": "RESEARCH"}}}, "then": {"required": ["evidence_ids"]}},
    {"if": {"properties": {"stage": {"const": "PLAN"}}}, "then": {"required": ["plan_status", "plan_sha256"]}},
    {"if": {"properties": {"stage": {"const": "PLAN_REVIEW"}}}, "then": {"required": ["review_status", "reviewed_by", "reviewed_plan_sha256"]}}
  ],
  "unevaluatedProperties": false
}
